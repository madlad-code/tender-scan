# TED Search API base URL. The public search endpoints are anonymous — no API key
# is required for reading published notices. Override only for testing/proxying.
TED_API_BASE_URL=https://api.ted.europa.eu

# Path to the local SQLite database.
TENDER_SCAN_DB=tender_scan.db

# Tailscale auth key for the docker-compose setup (docker-compose.yml).
# Generate at https://login.tailscale.com/admin/settings/keys — keep it secret.
TS_AUTHKEY=


# Gmail-hämtning av bifogade handlingar (scripts/hamta_bilagor.py).
# App-lösenordet är samma som send_batch.py använder för SMTP; skapa vid behov
# ett nytt på https://myaccount.google.com/apppasswords — det är inte ditt
# vanliga lösenord och ska hållas hemligt.
GMAIL_USER=
GMAIL_APP_PASSWORD=
